# Copy to .env. This file holds the ORGANIZATION API key: it is read by
# setup_allocation_agent.py and web.py, which create and drive sessions.
#
# worker.py — the process that actually runs agent tool calls — reads .env.worker
# instead (the block at the bottom of this file) and refuses to start if it finds
# an ANTHROPIC_API_KEY in its environment. Keep the two files separate; that
# split is the credential boundary, not filing.

ANTHROPIC_API_KEY=

# Printed by setup_allocation_agent.py. No vault: the data is a seeded generator
# answered by worker.py on the host, so there is no credential to store.
ALLOC_AGENT_ID=
ALLOC_ENV_ID=
ALLOC_SKILL_ID=

# Where the worker runs tool calls, and where web.py archives a finished
# session's files. Default to ~/xas-alloc-sandbox and ~/xas-alloc-sessions —
# OUTSIDE the repo on purpose: the file tools confine to the workdir but bash
# does not, and a sandbox inside the repo puts this file one `cd ..` away.
ALLOC_SANDBOX_ROOT=
ALLOC_SESSIONS_ROOT=

# ---- .env.worker (a SEPARATE file — copy this block into it) ----------------
# Read by worker.py. ANTHROPIC_API_KEY must NOT appear here.
#
# ALLOC_ENV_ID=
# ANTHROPIC_ENVIRONMENT_KEY=   # Console: Workspace > Environments > your env > Generate key
# ALLOC_SANDBOX_ROOT=          # default: ~/xas-alloc-sandbox (keep it outside the repo)
