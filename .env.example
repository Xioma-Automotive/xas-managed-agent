# Copy to .env. Holds the organization API key, read by setup_agent.py and web.py.
#
# The sandbox is Anthropic-hosted on this branch: there is no worker, no
# .env.worker, and no environment key. web.py is the only process.

ANTHROPIC_API_KEY=

# Printed by setup_agent.py. No vault: the data is a seeded generator answered by
# web.py, so there is no credential to store.
#
# ONE agent carries BOTH skills (allocation repair + reporting), so there are two
# skill IDs against a single ALLOC_AGENT_ID. If you already have the first three,
# setup_agent.py adds the reporting skill and prints only QA_SKILL_ID.
#
# These must be a CLOUD set. The self-hosted branch's IDs will not work here —
# setup_allocation_agent.py checks and refuses rather than cross-wiring them.
ALLOC_AGENT_ID=
ALLOC_ENV_ID=
ALLOC_SKILL_ID=
QA_SKILL_ID=

# Where /session/{id}/files/download puts the agent's outputs.
# Default: ~/xas-alloc-outputs
ALLOC_DOWNLOAD_DIR=

# Where the allocation pull comes from (datasource.get_source()). web.py fetches
# it HOST-SIDE at session start and mounts it into the sandbox as a file — the
# sandbox never calls the source and never sees these credentials.
#   scenario (default) — the fabricated dataset, offline, no credentials.
#   xas                — the real XAS endpoint (needs the two vars below).
#
# The reporting mount (the job-card records) comes from the same source module.
# The tenant taxonomy is NOT mounted — it ships inside the xas-qa skill bundle
# (DECIDE-16), so there is nothing to configure here and no per-session choice
# of dealership.
XAS_DATA_SOURCE=scenario
XAS_API_BASE=
XAS_API_TOKEN=
