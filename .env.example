# Copy to .env. Holds the organization API key, read by setup_agent.py and web.py.
#
# The sandbox is Anthropic-hosted on this branch: there is no worker, no
# .env.worker, and no environment key. web.py is the only process.

ANTHROPIC_API_KEY=

# Printed by setup_agent.py. ONE vault, for the app MCP only (see the block at the
# end) — the allocation data needs no credential, it is fetched host-side.
#
# ONE agent carries BOTH skills (allocation repair + reporting), so there are two
# skill IDs against a single ALLOC_AGENT_ID. If you already have the first three,
# setup_agent.py adds the reporting skill and prints only REPORTING_SKILL_ID.
#
# These must be a CLOUD set. The self-hosted branch's IDs will not work here —
# setup_allocation_agent.py checks and refuses rather than cross-wiring them.
ALLOC_AGENT_ID=
ALLOC_ENV_ID=
ALLOC_SKILL_ID=
REPORTING_SKILL_ID=

# Where /session/{id}/files/download puts the agent's outputs.
# Default: ~/xas-alloc-outputs
ALLOC_DOWNLOAD_DIR=

# Where the allocation pull comes from (datasource.get_source()). web.py reads
# it HOST-SIDE at session start and mounts it into the sandbox as a file — the
# sandbox never reads the source itself. There is ONE source and it needs no
# credential: a scenario directory of the real export under `data/`, two CSVs
# plus a `scenario.json` sidecar carrying the pull date. Run
# `uv run python -m datasource --list` for the scenarios and `--census` for what
# a pull kept and dropped.
#
# The tenant taxonomy is NOT mounted — it ships inside the xas-reporting skill bundle
# (DECIDE-16), so there is nothing to configure here and no per-session choice
# of dealership. The reporting lane has no mount at all; it reads the live
# system through the app MCP below.
# Which scenario the web form starts on; the per-session picker overrides it.
# XAS_PULL_NOW overrides the pull date for a what-if — never the clock.
XAS_SCENARIO=scenario-mixed

# --- app MCP (dev): the reporting lane's LIVE tools.
#
# All six are required TOGETHER — appmcp_auth.configured() is all-or-nothing,
# because half a configuration produces an agent that declares the MCP and calls
# it unauthenticated (which looks like a 401 from the MCP, not a config error).
# Leave them all empty to run without the live tools; the mounted records still
# answer every reporting question.
#
# MCP_TOKEN_ENC_KEY encrypts the outer JWE and never leaves this host. The vault
# holds the minted bearer write-only: Anthropic's proxy adds it at egress, so the
# sandbox never sees it. web.py re-mints every 20 minutes because the inner
# __DMS_app_token the gateway issues at login lives only 30.
#
# The vault and credential are created out-of-band (Console or a one-off script);
# appmcp_auth.py only ever UPDATES the credential it is pointed at.
MCP_TOKEN_ENC_KEY=
APPMCP_VAULT_ID=
APPMCP_CREDENTIAL_ID=
APPMCP_COMPANY_DB=
APPMCP_LOGIN_EMAIL=
APPMCP_LOGIN_PASSWORD=
