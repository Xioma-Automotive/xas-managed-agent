# XAS Q&A managed agent — Milestone 0 (mounted-data spike)
# Copy to qa/.env and fill in. Only the org API key is required to start;
# the two IDs are printed by setup_xas_qa.py on first run.

ANTHROPIC_API_KEY=

# Printed by `uv run python qa/setup_xas_qa.py` — paste them back here.
XAS_QA_ENV_ID=
XAS_QA_AGENT_ID=

# Optional: which Claude model the agent runs on (per-session override).
# claude-sonnet-4-5 (default) is a good balance; claude-opus-5 for hardest reasoning.
XAS_QA_MODEL=claude-sonnet-4-5
