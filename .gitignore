# Secrets — never commit. Ignore every .env variant and allow back only the
# committed template: an untracked credentials file is one `git add -A` away
# from a commit.
.env*
!.env.example

# Local solver artifacts, from running xas_allocation.session by hand
ledger.json
residual_cache.json
snapshot.json
plan.json

# QA agent chart outputs downloaded from sessions (qa/run_qa.py)
qa-outputs/

# Python cruft
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Local Claude Code state (worktrees are embedded repos)
.claude/
